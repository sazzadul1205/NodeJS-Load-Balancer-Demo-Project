PORT=9001
NAME=blog-9001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=blog

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Raise these for load tests, otherwise 429s will hide the round-robin.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=3000
AUTH_RATE_LIMIT_MAX=20

# Views are buffered in memory and flushed to MySQL every N ms.
VIEW_FLUSH_MS=10000

# Optional. When set, POST /api/admin/reset requires header x-admin-token: <value>.
# When unset, reset is allowed in dev and blocked in production.
ADMIN_TOKEN=
